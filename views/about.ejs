<%- include('partials/head', { title: title, description: 'Meet the Praesentia leadership team — experienced in-house counsel and proven operators with 37+ combined years across corporate, high-tech, and commercial legal practice.' }) %>
<%- include('partials/nav') %>

<!-- ===== PAGE HERO ===== -->
<header class="page-hero">
  <div class="container">
    <span class="eyebrow center" data-reveal>Leadership Team</span>
    <h1 data-reveal data-reveal-delay="1">Experienced In-House Counsel.<br><span style="background: var(--gradient-gold); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: var(--c-accent);">Proven Operators.</span></h1>
    <p data-reveal data-reveal-delay="2">Over 37 combined years of corporate, high-tech, and commercial legal experience inside scale-ups and enterprises.</p>
  </div>
</header>

<!-- ===== TEAM ===== -->
<section class="profile-section">
  <div class="container">
    <% team.forEach((member, idx) => { %>
      <div class="profile-row" data-reveal data-reveal-delay="<%= idx + 1 %>">
        <div class="profile-photo-col">
          <div class="profile-img-wrap">
            <img src="/img/<%= member.photo %>" alt="<%= member.name %>">
          </div>
        </div>
        
        <div class="profile-info-col">
          <h2 class="profile-name"><%= member.name %></h2>
          <span class="profile-role"><%= member.role %></span>
          
          <ul class="profile-bio-list">
            <% member.bio.forEach(b => { %>
              <li class="profile-bio-item"><%= b %></li>
            <% }); %>
          </ul>
          

        </div>
      </div>
    <% }); %>
    
    <div style="max-width:720px;margin:var(--sp-9) auto 0;text-align:center" data-reveal>
      <p class="quote-block dark-quote" style="font-size:1.3rem">"Over 37+ combined years of corporate, high-tech, and commercial legal experience inside scale-ups and enterprises."</p>
    </div>
  </div>
</section>

<!-- ===== PROVEN RESULTS ===== -->
<section class="section bg-alt">
  <div class="container">
    <div class="result-header" data-reveal>
      <span class="eyebrow" style="margin-bottom:0;">Proven Results</span>
    </div>
    
    <h2 class="section-title" data-reveal data-reveal-delay="1" style="margin-top: var(--sp-4); margin-bottom: var(--sp-5);">
      What We Have Helped <span class="result-title-hl" style="background: var(--gradient-gold); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: var(--c-accent);">Organizations Achieve</span>
    </h2>
    
    <p class="section-sub" data-reveal data-reveal-delay="2" style="max-width: 850px; margin-bottom: var(--sp-7);">
      Praesentia is focused entirely on measurable, strategic business outcomes. We measure success by the organizational maturity and structural efficiency we build inside your team.
    </p>
    
    <div class="grid grid-2" style="gap: var(--sp-5);">
      <div class="result-card" data-reveal data-reveal-delay="1">
        <h3>🏢 Built Legal Functions From The Ground Up</h3>
        <p>Structuring templates, playbooks, policies, and cross-functional legal workflows. We eliminate founder dependency on contract drafting and routine approvals.</p>
      </div>
      
      <div class="result-card" data-reveal data-reveal-delay="2">
        <h3>🌍 Supported Multi-Jurisdiction Operations</h3>
        <p>Setting up and running legal frameworks across the US, India, and West Asia. Ensuring seamless global expansion, corporate governance, and multi-currency structuring.</p>
      </div>
      
      <div class="result-card" data-reveal data-reveal-delay="3">
        <h3>⚙️ Designed Scalable Legal Operations</h3>
        <p>Introducing Contract Lifecycle Management (CLM) tools, automation workflows, and clear metrics reporting. Drastically reducing turnaround times for sales contracts.</p>
      </div>
      
      <div class="result-card" data-reveal data-reveal-delay="4">
        <h3>📈 Enabled Growth Through Legal Infrastructure</h3>
        <p>Unlocking transactional speed and ensuring compliance that keeps the board and institutional investors fully aligned. We turn legal from a blocker to a sales enabler.</p>
      </div>
    </div>
    
    <div class="quote-center" data-reveal data-reveal-delay="5">
      "By establishing professional infrastructure, we prepare growth-stage organizations for next-stage scale."
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-band">
  <div class="container">
    <h2 data-reveal>Ready to work with a partner who sits inside your business?</h2>
    <div data-reveal data-reveal-delay="2">
      <a href="/contact" class="btn btn-primary">Schedule a Consultation</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>