<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= site.name %> — <%= title %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : site.description %>">
  <link rel="canonical" href="<%= site.url %><%= currentPath === '/' ? '/' : currentPath %>">
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= site.name %> — <%= title %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : site.description %>">
  <meta property="og:url" content="<%= site.url %><%= currentPath %>">
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%230a1228'/><text x='50' y='72' font-size='56' font-family='Georgia' fill='%23c9a227' text-anchor='middle' font-weight='bold'>P</text></svg>">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="scroll-progress"></div>