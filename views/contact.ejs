<%- include('partials/head', { title: title, description: 'Get in touch with Praesentia. Schedule a consultation to explore how our fractional General Counsel model can support your growth-stage business.' }) %>
<%- include('partials/nav') %>



<!-- ===== CONTACT ===== -->
<section class="section-sm">
  <div class="container">
    <div class="split" style="max-width:1000px;margin:0 auto;gap:var(--sp-8)">
      <!-- Form -->
      <div data-reveal>
        <h2 style="font-family:var(--ff-serif);font-size:1.8rem;margin-bottom:var(--sp-5)">Schedule a Consultation</h2>
        <% if (typeof submitted !== 'undefined' && submitted) { %>
          <div class="form-success">✓ Thank you — we'll be in touch within one business day.</div>
        <% } %>
        <form action="/contact" method="POST" autocomplete="on" id="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="fname">First Name</label>
              <input type="text" id="fname" name="fname" required placeholder="Jane">
            </div>
            <div class="form-group">
              <label for="lname">Last Name</label>
              <input type="text" id="lname" name="lname" required placeholder="Doe">
            </div>
          </div>
          <div class="form-group">
            <label for="email">Work Email</label>
            <input type="email" id="email" name="email" required placeholder="jane@company.com">
          </div>
          <div class="form-group">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" placeholder="Acme Inc.">
          </div>
          <div class="form-group">
            <label for="message">How can we help?</label>
            <textarea id="message" name="message" placeholder="Tell us about your business, your legal needs, and where you're headed…"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%">Send Message</button>
          <p class="form-note">We'll respond within one business day. Your information is kept strictly confidential.</p>
        </form>
      </div>

      <!-- Info -->
      <div data-reveal data-reveal-delay="2">

        <div class="card" style="padding:var(--sp-7);margin-bottom:var(--sp-5)">
          <h3 style="font-family:var(--ff-serif);font-size:1.4rem;margin-bottom:var(--sp-5)">Get in Touch</h3>
          <div style="display:flex;flex-direction:column;gap:var(--sp-4)">
            <div style="display:flex;gap:14px;align-items:center"><span style="font-size:1.4rem">✉️</span><div><div style="font-size:.8rem;color:var(--c-text-soft);text-transform:uppercase;letter-spacing:.08em">Email</div><a href="mailto:<%= site.email %>" style="font-weight:600"><%= site.email %></a></div></div>
            <div style="display:flex;gap:14px;align-items:center"><span style="font-size:1.4rem">🌐</span><div><div style="font-size:.8rem;color:var(--c-text-soft);text-transform:uppercase;letter-spacing:.08em">Website</div><a href="<%= site.url %>" style="font-weight:600">praesentialegal.com</a></div></div>
            <div style="display:flex;gap:14px;align-items:center"><span style="font-size:1.4rem;font-weight:700">in</span><div><div style="font-size:.8rem;color:var(--c-text-soft);text-transform:uppercase;letter-spacing:.08em">LinkedIn</div><a href="<%= site.linkedin %>" target="_blank" rel="noopener" style="font-weight:600">Connect with us</a></div></div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>