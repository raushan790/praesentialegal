<%- include('partials/head', { title: title, description: 'Proven results — how Praesentia has helped organizations build legal functions from the ground up, support multi-jurisdiction operations, design scalable legal operations, and enable growth through legal infrastructure.' }) %>
<%- include('partials/nav') %>

<!-- ===== PAGE HERO ===== -->
<header class="page-hero">
  <div class="container">
    <span class="eyebrow center" data-reveal>Proven Results</span>
    <h1 data-reveal data-reveal-delay="1">What We Have Helped Organizations Achieve</h1>
    <p data-reveal data-reveal-delay="2">Praesentia is focused entirely on measurable, strategic business outcomes. We measure success by the organizational maturity and structural efficiency we build inside your team.</p>
  </div>
</header>

<!-- ===== STATS BAND ===== -->
<section class="bg-dark" style="padding:var(--sp-8) 0">
  <div class="container">
    <div class="stats-band">
      <% stats.forEach((s, idx) => { %>
        <div class="stat-block" data-reveal data-reveal-delay="<%= idx + 1 %>">
          <div class="num"><span data-count="<%= s.num %>">0</span><%= s.suffix %></div>
          <div class="lbl"><%= s.label %></div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ===== RESULTS TIMELINE ===== -->
<section class="section">
  <div class="container-narrow">
    <div class="section-head center" data-reveal>
      <span class="eyebrow center">Our Impact</span>
      <h2 class="section-title">Building Legal Functions That Create Value</h2>
    </div>
    <div class="timeline" style="margin-top:var(--sp-7)">
      <% const results = [
        {h:'Built Legal Functions From The Ground Up',d:'Structuring templates, playbooks, policies, and cross-functional legal workflows. We eliminate founder dependency on contract drafting and routine approvals — turning legal from a blocker into a sales enabler.'},
        {h:'Supported Multi-Jurisdiction Operations',d:'Setting up and running legal frameworks across the US, India, and West Asia. Ensuring seamless global expansion, corporate governance, and multi-currency structuring.'},
        {h:'Designed Scalable Legal Operations',d:'Introducing Contract Lifecycle Management (CLM) tools, automation workflows, and clear metrics reporting. Drastically reducing turnaround times for sales contracts.'},
        {h:'Enabled Growth Through Legal Infrastructure',d:'Unlocking transactional speed and ensuring compliance that keeps the board and institutional investors fully aligned. We turn legal from a blocker to a sales enabler.'}
      ]; results.forEach((r, idx) => { %>
        <div class="timeline-item" data-reveal data-reveal-delay="<%= idx + 1 %>">
          <h4><%= r.h %></h4>
          <p><%= r.d %></p>
        </div>
      <% }); %>
    </div>
    <div style="text-align:center;margin-top:var(--sp-8)" data-reveal>
      <p class="quote-block dark-quote" style="font-size:1.3rem">"By establishing professional infrastructure, we prepare growth-stage organizations for next-stage scale."</p>
    </div>
  </div>
</section>

<!-- ===== IMPACT AREAS ===== -->
<section class="section bg-alt">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow center">Where We Create Immediate Impact</span>
      <h2 class="section-title">Six Areas of Immediate Value</h2>
    </div>
    <div class="grid grid-3">
      <% impactAreas.forEach((area, idx) => { %>
        <div class="card" data-reveal data-reveal-delay="<%= (idx % 3) + 1 %>">
          <span class="num-tag"><%= area.num %></span>
          <div class="icon"><%= area.icon %></div>
          <h3><%= area.title %></h3>
          <p><strong>Problem:</strong> <%= area.problem %>.<br><strong>Solution:</strong> <%= area.solution %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-band">
  <div class="container">
    <h2 data-reveal>Helping leadership teams make faster, better-informed business decisions.</h2>
    <div data-reveal data-reveal-delay="2">
      <a href="/contact" class="btn btn-primary">Schedule a Consultation</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>